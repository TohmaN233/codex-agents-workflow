g"}},"required":["findings","sources","open_questions"],"type":"object"},"prompt_template":"Independently search for adjacent problems whose proof patterns could transfer to {{task}}. Explain the proposed bridge, every missing hypothesis, and a smallest test of the analogy. Return findings, sources, and open questions. Do not edit files or create a persistent task.","retry":{"max_attempts":3},"role":"implementer","type":"agent"},{"access":"read_only","approval":{"required":false},"executor":{"kind":"provider","provider_id":"native-sol"},"id":"counterexample_hunt","input_bindings":{"problem_card":"/nodes/freeze_problem_card/output/problem_card","task":"/inputs/task"},"name":"Counterexample hunter · one-off worker","outputs_schema":{"additionalProperties":false,"properties":{"findings":{"minLength":1,"type":"string"},"open_questions":{"minLength":1,"type":"string"},"sources":{"minLength":1,"type":"string"}},"required":["findings","sources","open_questions"],"type":"object"},"prompt_template":"Act as an adversarial one-off researcher for {{task}}. Try to construct boundary cases, false generalizations, and counterexamples to the likely routes suggested by the problem card. Return findings, sources, and open questions. Remain read-only and do not create a persistent task.","retry":{"max_attempts":3},"role":"reviewer","type":"agent"},{"id":"survey_join","name":"Survey complete","parallel_id":"survey_fork","type":"join"},{"access":"read_only","approval":{"required":false},"executor":{"kind":"main"},"id":"assemble_research_board","input_bindings":{"analogy":"/nodes/analogy_bridge/output","counterexamples":"/nodes/counterexample_hunt/output","literature":"/nodes/literature_map/output","problem_card":"/nodes/freeze_problem_card/output/problem_card","task":"/inputs/task","toolbox":"/nodes/toolbox_map/output"},"name":"Assemble the research board","outputs_schema":{"additionalProperties":false,"properties":{"research_board":{"minLength":1,"type":"string"},"route_options":{"minLength":1,"type":"string"},"uncertainties":{"minLength":1,"type":"string"}},"required":["research_board","route_options","uncertainties"],"type":"object"},"prompt_template":"Compare the four independent survey reports for {{task}}. Build a research board with supported routes, rejected routes, unresolved dependencies, and at most three discriminating probes. Preserve disagreement instead of averaging it away. Output research_board, route_options, and uncertainties.","retry":{"max_attempts":3},"role":"advisor","type":"agent"},{"failure_policy":"collect","id":"probe_fork","join_id":"probe_join","name":"Parallel route probes","type":"parallel"},{"access":"read_only","approval":{"required":false},"executor":{"kind":"provider","provider_id":"native-luna"},"id":"route_probe_a","input_bindings":{"research_board":"/nodes/assemble_research_board/output/research_board","task":"/inputs/task"},"name":"Route probe A · one-off worker","outputs_schema":{"additionalProperties":false,"properties":{"disproof_attempt":{"minLength":1,"type":"string"},"evidence":{"minLength":1,"type":"string"},"route":{"minLength":1,"type":"string"}},"required":["route","evidence","disproof_attempt"],"type":"object"},"prompt_template":"Test the first promising route in the supplied research board for {{task}}. Work toward a decisive lemma or a decisive obstruction. Return route, evidence, and disproof_attempt. Do not edit files or create a persistent task.","retry":{"max_attempts":3},"role":"implementer","type":"agent"},{"access":"read_only","approval":{"required":false},"executor":{"kind":"provider","provider_id":"native-luna"},"id":"route_probe_b","input_bindings":{"research_board":"/nodes/assemble_research_board/output/research_board","task":"/inputs/task"},"name":"Route probe B · one-off worker","outputs_schema":{"additionalProperties":false,"properties":{"disproof_attempt":{"minLength":1,"type":"string"},"evidence":{"minLength":1,"type":"string"},"route":{"minLength":1,"type":"string"}},"required":["route","evidence","disproof_attempt"],"type":"object"},"prompt_template":"Test the second promising route in the supplied research board for {{task}}. Work toward a decisive lemma or a decisive obstruction. Return route, evidence, and disproof_attempt. Do not edit files or create a persistent task.","retry":{"max_attempts":3},"role":"implementer","type":"agent"},{"access":"read_only","approval":{"required":false},"executor":{"kind":"provider","provider_id":"native-sol"},"id":"route_probe_c","input_bindings":{"research_board":"/nodes/assemble_research_board/output/research_board","task":"/inputs/task"},"name":"Route probe C · one-off worker","outputs_schema":{"additionalProperties":false,"properties":{"disproof_attempt":{"minLength":1,"type":"string"},"evidence":{"minLength":1,"type":"string"},"route":{"minLength":1,"type":"string"}},"required":["route","evidence","disproof_attempt"],"type":"object"},"prompt_template":"Test the highest-uncertainty route in the supplied research board for {{task}}. Prefer a small calculation, construction, or reduction that can rule the route in or out. Return route, evidence, and disproof_attempt. Do not edit files or create a persistent task.","retry":{"max_attempts":3},"role":"implementer","type":"agent"},{"id":"probe_join","name":"Route probes complete","parallel_id":"probe_fork","type":"join"},{"access":"read_only","approval":{"required":false},"executor":{"kind":"main"},"id":"choose_research_mode","input_bindings":{"probe_a":"/nodes/route_probe_a/output","probe_b":"/nodes/route_probe_b/output","probe_c":"/nodes/route_probe_c/output","research_board":"/nodes/assemble_research_board/output/research_board","task":"/inputs/task"},"name":"Choose the research mode","outputs_schema":{"additionalProperties":false,"properties":{"mode":{"minLength":1,"type":"string"},"research_board":{"minLength":1,"type":"string"},"selected_route":{"minLength":1,"type":"string"}},"required":["mode","selected_route","research_board"],"type":"object"},"prompt_template":"Use the research board and all three route probes to decide whether {{task}} needs a single persistent research state or can finish as a one-shot synthesis. Set mode to exactly persistent only when one route needs iterative work over a shared evolving board; otherwise set it to one_shot. Output mode, selected_route, and the updated research_board.","retry":{"max_attempts":3},"role":"advisor","type":"agent"},{"access":"read_only","approval":{"required":true},"executor":{"kind":"human"},"id":"confirm_persistent_state","name":"Confirm persistent research state","prompt_template":"Approve the decision to create or avoid a persistent Codex research task after reviewing the research board.","retry":{"max_attempts":1},"type":"human_gate"},{"cases":[{"label":"persistent","when":{"args":[{"path":"/nodes/choose_research_mode/output/mode"},{"value":"persistent"}],"op":"eq"}}],"default_label":"one_shot","id":"research_mode","name":"Persistent or one-shot research","type":"condition"},{"access":"bounded_write","approval":{"required":false},"executor":{"kind":"thread","lifecycle":"start","provider_id":"native-sol"},"id":"persistent_research_state","input_bindings":{"decision":"/nodes/choose_research_mode/output","task":"/inputs/task"},"name":"Persistent research state · start Codex task","outputs_schema":{"additionalProperties":false,"properties":{"recommendation":{"minLength":1,"type":"string"},"research_board":{"minLength":1,"type":"string"},"risk_register":{"minLength":1,"type":"string"}},"required":["recommendation","research_board","risk_register"],"type":"object"},"path_scope":{"binding":"run.allowed_paths"},"prompt_template":"Continue the selected route for {{task}} as a persistent research task. Maintain a clear research board: definitions, proven lemmas, failed attempts, open obligations, and next discriminating experiment. You may inspect tools and references wherever the host exposes them. Write only task material inside this Run's allowed workspace. Return recommendation, research_board, and risk_register.","retry":{"max_attempts":3},"role":"implementer","type":"agent"},{"access":"bounded_write","approval":{"required":false},"executor":{"kind":"thread","lifecycle":"continue","provider_id":"native-sol","source_node":"persistent_research_state"},"id":"persistent_research_continue","input_bindings":{"decision":"/nodes/choose_research_mode/output","previous_research":"/nodes/persistent_research_state/output","task":"/inputs/task"},"name":"Persistent research state · continue same Codex task","outputs_schema":{"additionalProperties":false,"properties":{"recommendation":{"minLength":1,"type":"string"},"research_board":{"minLength":1,"type":"string"},"risk_register":{"minLength":1,"type":"string"}},"required":["recommendation","research_board","risk_register"],"type":"object"},"path_scope":{"binding":"run.allowed_paths"},"prompt_template":"Resume the exact existing research task for {{task}}. Reconcile the previous research board with the selected route, strengthen the most promising argument, record every failed implication, and identify the next proof obligation. You may inspect tools and references wherever the host exposes them. Write only task material inside this Run's allowed workspace. Return recommendation, research_board, and risk_register.","retry":{"max_attempts":3},"role":"implementer","type":"agent"},{"access":"read_only","approval":{"required":false},"executor":{"kind":"provider","provider_id":"native-sol"},"id":"adversarial_review","input_bindings":{"decision":"/nodes/choose_research_mode/output","persistent_result":"/nodes/persistent_research_continue/output","task":"/inputs/task"},"name":"Adversarial review of persistent state","outputs_schema":{"additionalProperties":false,"properties":{"recommendation":{"minLength":1,"type":"string"},"research_board":{"minLength":1,"type":"string"},"risk_register":{"minLength":1,"type":"string"}},"required":["recommendation","research_board","risk_register"],"type":"object"},"prompt_template":"Review the persistent research result for {{task}}. Check each claimed implication against the problem card and seek a smallest counterexample or missing hypothesis. Do not repair the proof yourself. Return recommendation, research_board, and risk_register.","retry":{"max_attempts":3},"role":"reviewer","type":"agent"},{"access":"read_only","approval":{"required":false},"executor":{"kind":"provider","provider_id":"native-sol"},"id":"one_shot_review","input_bindings":{"decision":"/nodes/choose_research_mode/output","task":"/inputs/task"},"name":"One-shot synthesis and review","outputs_schema":{"additionalProperties":false,"properties":{"recommendation":{"minLength":1,"type":"string"},"research_board":{"minLength":1,"type":"string"},"risk_register":{"minLength":1,"type":"string"}},"required":["recommendation","research_board","risk_register"],"type":"object"},"prompt_template":"Produce an adversarial one-shot synthesis for {{task}} from the research board and route probes. Distinguish proved statements, plausible conjectures, and rejected paths. Do not edit files or create a persistent task. Return recommendation, research_board, and risk_register.","retry":{"max_attempts":3},"role":"reviewer","type":"agent"},{"access":"read_only","approval":{"required":false},"executor":{"kind":"main"},"id":"final","input_bindings":{"decision":"/nodes/choose_research_mode/output","human_confirmation":"/nodes/confirm_persistent_state/output/approved","selected_result":{"coalesce":["/nodes/adversarial_review/output","/nodes/one_shot_review/output"]},"task":"/inputs/task"},"name":"Main agent · accept research outcome","outputs_schema":{"additionalProperties":false,"properties":{"recommendation":{"minLength":1,"type":"string"},"research_board":{"minLength":1,"type":"string"},"risk_register":{"minLength":1,"type":"string"}},"required":["recommendation","research_board","risk_register"],"type":"object"},"prompt_template":"Inspect the selected research route and its evidence for {{task}}. Accept only claims that are supported by the problem card, the research board, and the adversarial review. Clearly state remaining proof obligations. Output recommendation, research_board, and risk_register.","retry":{"max_attempts":3},"role":"finalizer","type":"agent"},{"id":"end","type":"end"}],"output_bindings":{"recommendation":"/nodes/final/output/recommendation","research_board":"/nodes/final/output/research_board","risk_register":"/nodes/final/output/risk_register"},"outputs_schema":{"additionalProperties":false,"properties":{"recommendation":{"minLength":1,"type":"string"},"research_board":{"minLength":1,"type":"string"},"risk_register":{"minLength":1,"type":"string"}},"required":["recommendation","research_board","risk_register"],"type":"object"},"requirements":{"executables":[],"mcp_servers":[],"providers":["native-astra","native-luna","native-sol"],"tools":[]},"revision":12,"schema_version":1,"skill_policy":{"ambient_allow":[],"implicit":"allow","mode":"cooperative","shadowed_skill_paths":[]},"status":"ready","tags":["builtin","example","mathematics","hybrid"]}}}
